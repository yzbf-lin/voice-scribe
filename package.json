{
  "name": "voice-scribe",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first video/audio to text desktop app powered by faster-whisper",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,APP -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development node scripts/launch-electron.js\"",
    "dev:nosandbox": "concurrently -k -n VITE,APP -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development VS_NO_SANDBOX=1 node scripts/launch-electron.js\"",
    "dev:renderer": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && cross-env NODE_ENV=production node scripts/launch-electron.js",
    "setup:python": "bash scripts/setup-python.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.14.8",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}